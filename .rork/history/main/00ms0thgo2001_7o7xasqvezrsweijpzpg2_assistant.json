0c\u0000o\u0000m\u0000p\u0000o\u0000n\u0000e\u0000n\u0000t\u0000s\u0000:\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000k\u0000t\u0000x\u0000.\u0000F\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000C\u0000o\u0000m\u0000m\u0000o\u0000n\u0000L\u0000e\u0000g\u0000a\u0000c\u0000y\u0000R\u0000e\u0000g\u0000i\u0000s\u0000t\u0000r\u0000a\u0000r\u0000\u0000\u0000Z\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000c\u0000o\u0000m\u0000p\u0000o\u0000n\u0000e\u0000n\u0000t\u0000s\u0000:\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000m\u0000e\u0000s\u0000s\u0000a\u0000g\u0000i\u0000n\u0000g\u0000.\u0000F\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000M\u0000e\u0000s\u0000s\u0000a\u0000g\u0000i\u0000n\u0000g\u0000K\u0000t\u0000x\u0000R\u0000e\u0000g\u0000i\u0000s\u0000t\u0000r\u0000a\u0000r\u0000\u0000\u0000W\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000c\u0000o\u0000m\u0000p\u0000o\u0000n\u0000e\u0000n\u0000t\u0000s\u0000:\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000m\u0000e\u0000s\u0000s\u0000a\u0000g\u0000i\u0000n\u0000g\u0000.\u0000F\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000M\u0000e\u0000s\u0000s\u0000a\u0000g\u0000i\u0000n\u0000g\u0000R\u0000e\u0000g\u0000i\u0000s\u0000t\u0000r\u0000a\u0000r\u0000\u0000\u00002\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000i\u0000i\u0000d\u0000.\u0000F\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000I\u0000n\u0000s\u0000t\u0000a\u0000n\u0000c\u0000e\u0000I\u0000d\u0000R\u0000e\u0000c\u0000e\u0000i\u0000v\u0000e\u0000r\u0000\u0000\u00006\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000m\u0000e\u0000s\u0000s\u0000a\u0000g\u0000i\u0000n\u0000g\u0000.\u0000F\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000M\u0000e\u0000s\u0000s\u0000a\u0000g\u0000i\u0000n\u0000g\u0000S\u0000e\u0000r\u0000v\u0000i\u0000c\u0000e\u0000\u0000\u00001\u0000c\u0000o\u0000m\u0000.\u0000g\u0000o\u0000o\u0000g\u0000l\u0000e\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000.\u0000p\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000.\u0000F\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000I\u0000n\u0000i\u0000t\u0000P\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000\u0000\u0000'\u0000c\u0000o\u0000m\u0000.\u0000h\u0000t\u0000c\u0000.\u0000i\u0000n\u0000t\u0000e\u0000n\u0000t\u0000.\u0000a\u0000c\u0000t\u0000i\u0000o\u0000n\u0000.\u0000Q\u0000U\u0000I\u0000C\u0000K\u0000B\u0000O\u0000O\u0000T\u0000_\u0000P\u0000O\u0000W\u0000E\u0000R\u0000O\u0000N\u0000\u0000\u0000)\u0000c\u0000o\u0000m\u0000.\u0000h\u0000t\u0000c\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000R\u0000E\u0000A\u0000D\u0000_\u0000S\u0000E\u0000T\u0000T\u0000I\u0000N\u0000G\u0000S\u0000\u0000\u0000+\u0000c\u0000o\u0000m\u0000.\u0000h\u0000t\u0000c\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000U\u0000P\u0000D\u0000A\u0000T\u0000E\u0000_\u0000S\u0000H\u0000O\u0000R\u0000T\u0000C\u0000U\u0000T\u0000\u0000\u00003\u0000c\u0000o\u0000m\u0000.\u0000h\u0000u\u0000a\u0000w\u0000e\u0000i\u0000.\u0000a\u0000n\u0000d\u0000r\u0000o\u0000i\u0000d\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000C\u0000H\u0000A\u0000N\u0000G\u0000E\u0000_\u0000B\u0000A\u0000D\u0000G\u0000E\u0000\u0000\u00004\u0000c\u0000o\u0000m\u0000.\u0000h\u0000u\u0000a\u0000w\u0000e\u0000i\u0000.\u0000a\u0000n\u0000d\u0000r\u0000o\u0000i\u0000d\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000R\u0000E\u0000A\u0000D\u0000_\u0000S\u0000E\u0000T\u0000T\u0000I\u0000N\u0000G\u0000S\u0000\u0000\u00005\u0000c\u0000o\u0000m\u0000.\u0000h\u0000u\u0000a\u0000w\u0000e\u0000i\u0000.\u0000a\u0000n\u0000d\u0000r\u0000o\u0000i\u0000d\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000W\u0000R\u0000I\u0000T\u0000E\u0000_\u0000S\u0000E\u0000T\u0000T\u0000I\u0000N\u0000G\u0000S\u0000\u0000\u0000\u0013\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000\u0000\u0000)\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000C\u0000l\u0000i\u0000p\u0000b\u0000o\u0000a\u0000r\u0000d\u0000F\u0000i\u0000l\u0000e\u0000P\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000\u0000\u0000<\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000D\u0000Y\u0000N\u0000A\u0000M\u0000I\u0000C\u0000_\u0000R\u0000E\u0000C\u0000E\u0000I\u0000V\u0000E\u0000R\u0000_\u0000N\u0000O\u0000T\u0000_\u0000E\u0000X\u0000P\u0000O\u0000R\u0000T\u0000E\u0000D\u0000_\u0000P\u0000E\u0000R\u0000M\u0000I\u0000S\u0000S\u0000I\u0000O\u0000N\u0000\u0000\u0000*\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000F\u0000i\u0000l\u0000e\u0000S\u0000y\u0000s\u0000t\u0000e\u0000m\u0000F\u0000i\u0000l\u0000e\u0000P\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000\u0000\u0000+\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000I\u0000m\u0000a\u0000g\u0000e\u0000P\u0000i\u0000c\u0000k\u0000e\u0000r\u0000F\u0000i\u0000l\u0000e\u0000P\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000\u0000\u0000 \u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000M\u0000a\u0000i\u0000n\u0000A\u0000c\u0000t\u0000i\u0000v\u0000i\u0000t\u0000y\u0000\u0000\u0000#\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000M\u0000a\u0000i\u0000n\u0000A\u0000p\u0000p\u0000l\u0000i\u0000c\u0000a\u0000t\u0000i\u0000o\u0000n\u0000\u0000\u0000'\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000S\u0000h\u0000a\u0000r\u0000i\u0000n\u0000g\u0000F\u0000i\u0000l\u0000e\u0000P\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000\u0000\u0000$\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000a\u0000n\u0000d\u0000r\u0000o\u0000i\u0000d\u0000x\u0000-\u0000s\u0000t\u0000a\u0000r\u0000t\u0000u\u0000p\u0000\u0000\u0000(\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000c\u0000r\u0000o\u0000p\u0000p\u0000e\u0000r\u0000.\u0000f\u0000i\u0000l\u0000e\u0000p\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000\u0000\u0000(\u0000c\u0000o\u0000m\u0000.\u0000i\u0000v\u0000x\u0000h\u0000o\u0000l\u0000d\u0000i\u0000n\u0000g\u0000s\u0000.\u0000a\u0000p\u0000p\u0000.\u0000f\u0000i\u0000r\u0000e\u0000b\u0000a\u0000s\u0000e\u0000i\u0000n\u0000i\u0000t\u0000p\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000\u0000\u0000+\u0000c\u0000o\u0000m\u0000.\u0000m\u0000a\u0000j\u0000e\u0000u\u0000r\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000U\u0000P\u0000D\u0000A\u0000T\u0000E\u0000_\u0000B\u0000A\u0000D\u0000G\u0000E\u0000\u0000\u0000*\u0000c\u0000o\u0000m\u0000.\u0000o\u0000p\u0000p\u0000o\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000R\u0000E\u0000A\u0000D\u0000_\u0000S\u0000E\u0000T\u0000T\u0000I\u0000N\u0000G\u0000S\u0000\u0000\u0000+\u0000c\u0000o\u0000m\u0000.\u0000o\u0000p\u0000p\u0000o\u0000.\u0000l\u0000a\u0000u\u0000n\u0000c\u0000h\u0000e\u0000r\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000W\u0000R\u0000I\u0000T\u0000E\u0000_\u0000S\u0000E\u0000T\u0000T\u0000I\u0000N\u0000G\u0000S\u0000\u0000\u0000.\u0000c\u0000o\u0000m\u0000.\u0000s\u0000e\u0000c\u0000.\u0000a\u0000n\u0000d\u0000r\u0000o\u0000i\u0000d\u0000.\u0000p\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000.\u0000b\u0000a\u0000d\u0000g\u0000e\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000R\u0000E\u0000A\u0000D\u0000\u0000\u0000/\u0000c\u0000o\u0000m\u0000.\u0000s\u0000e\u0000c\u0000.\u0000a\u0000n\u0000d\u0000r\u0000o\u0000i\u0000d\u0000.\u0000p\u0000r\u0000o\u0000v\u0000i\u0000d\u0000e\u0000r\u0000.\u0000b\u0000a\u0000d\u0000g\u0000e\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u0000n\u0000.\u0000W\u0000R\u0000I\u0000T\u0000E\u0000\u0000\u00000\u0000c\u0000o\u0000m\u0000.\u0000s\u0000o\u0000n\u0000y\u0000e\u0000r\u0000i\u0000c\u0000s\u0000s\u0000o\u0000n\u0000.\u0000h\u0000o\u0000m\u0000e\u0000.\u0000p\u0000e\u0000r\u0000m\u0000i\u0000s\u0000s\u0000i\u0000o\u00