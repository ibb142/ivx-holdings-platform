# Generate .env with python3 prepare.py; do not use empty keys.
LITELLM_MASTER_KEY=
QDRANT_API_KEY=
OLLAMA_MODEL=llama3.1:70b
# Local inference slots, independent of the 12-agent orchestration ceiling.
IVX_LOCAL_CONCURRENCY=1

# Backend opt-in. prepare.py copies the generated gateway key to OPENAI_API_KEY.
# Loopback works only when the backend runs on this same host.
IVX_AI_PROVIDER=litellm
IVX_AI_MODEL=ivx-local-chat
OPENAI_API_BASE=http://127.0.0.1:4000/v1
OPENAI_API_KEY=
