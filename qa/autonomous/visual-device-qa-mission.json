{
  "programId": "IVX-VISUAL-DEVICE-QA-112",
  "title": "112-Agent Human-Like Visual Device QA",
  "objective": "Make Autonomous + 112 IA validate IVX like human users on iPhone and Android by combining real device/simulator interaction, screenshots/video, UI hierarchy evidence, keyboard/rotation/background tests, independent visual review, and fail-closed certification.",
  "platforms": ["ios", "android"],
  "deviceClasses": [
    "ios-small",
    "ios-standard",
    "ios-large",
    "android-small",
    "android-standard",
    "android-large",
    "tablet"
  ],
  "humanLikeActions": [
    "launch",
    "tap",
    "double-tap",
    "long-press",
    "type",
    "clear-text",
    "submit-keyboard",
    "scroll",
    "swipe",
    "back",
    "rotate",
    "background",
    "foreground",
    "reload",
    "deep-link",
    "open-modal",
    "close-modal"
  ],
  "visualDefects": [
    "text-overlap",
    "text-clipping",
    "keyboard-obscures-input",
    "button-obscured",
    "button-offscreen",
    "safe-area-violation",
    "modal-overlap",
    "header-overlap",
    "footer-overlap",
    "image-crop-error",
    "aspect-ratio-error",
    "blank-screen",
    "black-screen",
    "stale-loader",
    "infinite-spinner",
    "unexpected-white-space",
    "layout-shift",
    "touch-target-too-small",
    "contrast-risk",
    "truncated-localized-copy"
  ],
  "evidenceRequiredPerFinding": [
    "platform",
    "device-profile",
    "source-sha",
    "screen-route",
    "action-sequence",
    "screenshot-before",
    "screenshot-after",
    "ui-hierarchy-or-accessibility-tree",
    "finding-bounding-box-or-element-id",
    "severity",
    "reproduction-steps",
    "agent-id",
    "independent-qa-agent-id"
  ],
  "certificationChain": [
    "INTERACT_ON_REAL_SIMULATOR_OR_DEVICE",
    "CAPTURE_VISUAL_EVIDENCE",
    "DETECT_DEFECT",
    "CREATE_DEFECT_RECORD",
    "ASSIGN_IMPLEMENTER",
    "FIX",
    "CODE_REVIEW",
    "REPLAY_SAME_ACTION_SEQUENCE",
    "INDEPENDENT_VISUAL_QA",
    "E2E",
    "DEPLOY",
    "REPLAY_ON_PRODUCTION_BUILD",
    "EXACT_SHA_PROOF",
    "VISUAL_10_OF_10_CERTIFICATE"
  ],
  "hardRules": {
    "simulatedVisualEvidenceAllowed": false,
    "selfCertificationAllowed": false,
    "screenshotRequiredForVisualPass": true,
    "uiHierarchyRequiredWhenAvailable": true,
    "keyboardOverlapIsP1OrHigher": true,
    "blankOrBlackScreenIsP0": true,
    "productionCertificateRequiresExactSha": true,
    "zeroP0P1Required": true
  },
  "landingPriority": {
    "enabled": true,
    "scope": "LANDING_10OF10",
    "note": "During Landing P0, visual-device QA capacity is applied to Landing before other modules."
  }
}
