{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-simulator-qa": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "ios-simulator-qa",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true,
        "buildConfiguration": "Debug",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_SOURCE_COMMIT_SHA": "${COMMIT_SHA}",
        "EXPO_PUBLIC_QA_BUILD": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.ivxholding.com"
      },
      "credentialsSource": "remote"
    },
    "ios-device-qa": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "ios-device-qa",
      "ios": {
        "resourceClass": "m-medium",
        "buildConfiguration": "Debug",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_SOURCE_COMMIT_SHA": "${COMMIT_SHA}",
        "EXPO_PUBLIC_QA_BUILD": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.ivxholding.com"
      },
      "credentialsSource": "remote"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "${EXPO_PUBLIC_ASC_APP_ID}",
        "ascApiKeyPath": "./keys/asc-api-key.p8",
        "ascApiKeyIssuerId": "${EXPO_PUBLIC_ASC_ISSUER_ID}",
        "ascApiKeyId": "${EXPO_PUBLIC_ASC_KEY_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./keys/google-service-account.json",
        "track": "internal"
      }
    }
  }
}
